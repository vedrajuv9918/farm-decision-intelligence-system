# ─────────────────────────────────────────────
# FarmWise — Environment Variables Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your .env file — it is already in .gitignore.

# ── Database ──────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./farmwise.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/farmwise

# ── OpenWeatherMap ────────────────────────────
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ── Agmarknet — Current / Live Mandi Prices ──
# Used for: Live Mandi Prices page, current market summary, today's prices
# Resource ID: 35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_API_KEY_CURRENT=your_data_gov_api_key
DATA_GOV_RESOURCE_ID_CURRENT=35985678-0d79-46b4-9ed6-6f13308a1d24

# ── Agmarknet — Historical Mandi Prices ───────
# Used for: price trend charts, moving averages, market intelligence analysis
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY_HISTORICAL=your_data_gov_api_key
DATA_GOV_RESOURCE_ID_HISTORICAL=9ef84268-d588-465a-a308-a864a43d0070

# ── CORS ──────────────────────────────────────
# Frontend origin allowed to call the backend API
FRONTEND_ORIGIN=http://localhost:5173
